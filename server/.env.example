# Copy to .env (or set as real env vars / Cloud Run secrets) — never commit
# the filled-in version, since DATABASE_URL carries Supabase credentials.

# Supabase connection string (Project Settings > Database > Connection
# string > URI). Use the "connection pooling" URI in production.
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres?sslmode=disable

# Port the Go server listens on. Cloud Run injects this automatically.
PORT=8080

# Origin the frontend is served from — used both to build share URLs and
# as the CORS allow-origin for the REST API.
PUBLIC_BASE_URL=http://localhost:3000

# Fixed session lifetime in minutes (v2.0 spec §11.1-22: 1 hour, no extension).
SESSION_TTL_MINUTES=60

# Max POST /api/sessions requests allowed per IP per minute (spec §8-5).
RATE_LIMIT_RPM=5

# Electric-train ETA providers (v2.0 spec §7.1-§7.1.3). NAVITIME is tried
# first; once its free tier (500 calls/month) is used up, cocode falls back
# to Jorudan automatically — no code change needed, just fill in the key
# once the Jorudan application is approved. Both blank = /api/eta/transit
# returns 503, nothing else is affected.

# NAVITIME Transit API key, obtained via RapidAPI (Basic/free plan).
# Production copy lives in Secret Manager as cocode-navitime-api-key.
NAVITIME_RAPIDAPI_KEY=

# Jorudan Norikae-Annai Open API access key (application pending as of
# 2026-08-30). Leave blank until approved. Production copy lives in Secret
# Manager as cocode-jorudan-access-key.
JORUDAN_ACCESS_KEY=
# Only needed if Jorudan's approval email specifies a non-default endpoint.
JORUDAN_BASE_URL=

# MapTiler key, used server-side only to resolve "nearest station name" for
# Jorudan (which takes station names, not coordinates — spec §7.1.3). Same
# value as web/.env's NEXT_PUBLIC_MAPTILER_KEY (already public, so reusing
# it here is not a new exposure).
MAPTILER_KEY=

# Feedback notification mail (v2.0 spec §17.2), sent via Gmail's SMTP relay
# using an app password (myaccount.google.com/apppasswords) — same pattern
# as aibo_pj's feedbackmail package. Leave SMTP_PASSWORD blank to boot with
# feedback mail disabled (DB save still succeeds). Production copy of the
# password lives in Secret Manager as cocode-smtp-password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=osasadev@gmail.com
SMTP_PASSWORD=
FEEDBACK_NOTIFY_EMAIL=osasadev@gmail.com
