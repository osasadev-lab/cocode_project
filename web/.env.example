# Copy to .env.local for local development. All of these are NEXT_PUBLIC_*
# because they're baked into the static export at build time (spec §3) —
# there are no secrets here, just endpoint URLs.

# Go backend's REST base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Go backend's WebSocket base URL (note ws:// / wss://, not http(s)://).
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080

# MapLibre style URL. Sign up for a free MapTiler key and use the jp-gsi
# styles (v2.0 spec §4): light = jp-gsi-standard, dark = jp-gsi-dark.
NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/jp-gsi-standard/style.json?key=YOUR_KEY
NEXT_PUBLIC_MAP_STYLE_URL_DARK=https://api.maptiler.com/maps/jp-gsi-dark/style.json?key=YOUR_KEY

# Raw MapTiler key (same key as above), used for Geocoding API calls
# (spec §10).
NEXT_PUBLIC_MAPTILER_KEY=YOUR_KEY
