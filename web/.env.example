# Copy to .env.local for local development. All of these are NEXT_PUBLIC_*
# because they're baked into the static export at build time (spec §3) —
# there are no secrets here, just endpoint URLs.

# Go backend's REST base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Go backend's WebSocket base URL (note ws:// / wss://, not http(s)://).
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080

# MapLibre style URL. The default is MapLibre's free, no-signup demo style
# (fine for development, not meant for production). For a nicer basemap
# matching spec §9, sign up for a free MapTiler key and use e.g.
# https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
