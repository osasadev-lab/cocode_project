# web/.env.production.local のテンプレート(仕様書§16.1)。値は含めずキー名
# のみを記載する。実行時に実際に読まれるのは web/.env.production.local
# であり、このファイルをコピーして値を埋めてから使うこと。
#
# npm run build は NODE_ENV=production になるため、web/.env.local(ローカル
# 開発用・localhost向け)を書き換えずにこちらが自動的に使われる。

# Cloud RunのURL(バックエンド、asia-northeast1、service: cocode-server)。
NEXT_PUBLIC_API_BASE_URL=

# 同上のWebSocket版。wss://スキームにすること(ws://のままだと本番で接続できない)。
NEXT_PUBLIC_WS_BASE_URL=

# MapTilerのjp-gsi-standard/jp-gsi-darkスタイル(仕様書§4)。
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=

# 住所検索(MapTiler Geocoding API、仕様書§10.1)用の生キー。
# 上記スタイルURLに埋め込むキーと同じ値でよい。
NEXT_PUBLIC_MAPTILER_KEY=
